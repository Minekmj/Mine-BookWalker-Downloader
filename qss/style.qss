* {
  font-family: "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
  font-size: 12px;
}

QMainWindow, QDialog {
  background-color: #181920;
  color: #e4e6eb;
}

QLabel, QCheckBox, QRadioButton {
  background-color: transparent;
  color: #e4e6eb;
}

QLabel:disabled, QCheckBox:disabled, QRadioButton:disabled {
  color: #565a6e;
}

QTabWidget::pane {
  border: 1px solid #2e313d;
  border-radius: 6px;
  background-color: #21232c;
  padding: 10px;
}

QTabBar::tab {
  background-color: transparent;
  color: #8e92a4;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 8px 16px;
  margin-right: 4px;
}

QTabBar::tab:selected {
  color: #e4e6eb;
  font-weight: 700;
  border-bottom: 2px solid #a89ef0;
}

QTabBar::tab:hover:!selected {
  color: #c4c7d4;
}

QGroupBox {
  background-color: #21232c;
  border: 1px solid #2e313d;
  border-radius: 8px;
  margin-top: 12px;
  padding: 14px 12px 10px 12px;
  font-weight: 600;
  color: #c4c7d4;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 2px 8px;
  background-color: #21232c;
  border: 1px solid #2e313d;
  border-radius: 11px;
  color: #e4e6eb;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
  background-color: #21232c;
  color: #e4e6eb;
  border: 1px solid #323542;
  border-radius: 6px;
  padding: 4px 8px;
  min-height: 22px;
}

QComboBox {
  min-height: 30px;
  padding: 5px 30px 5px 9px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
  border-color: #a89ef0;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
  background-color: #1c1d24;
  color: #565a6e;
  border-color: #282a34;
}

QSpinBox, QDoubleSpinBox {
  padding-right: 20px;
  text-align: center;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 0px;
  background-color: transparent;
  border-left: 1px solid transparent;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 0px;
  background-color: transparent;
  border-left: 1px solid transparent;
  border-top: 1px solid transparent;
}

QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::down-arrow, QDoubleSpinBox::up-arrow {
  width: 0px;
  height: 0px;
  border: none;
}

QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 22px;
  border-left: 1px solid #323542;
  background-color: #2a2d38;
}

QComboBox::down-arrow {
  image: url(icons:arrow_down.png);
  width: 10px;
  height: 10px;
}

QComboBoxPrivateContainer,
QComboBoxPrivateContainer > QFrame,
QComboBox QAbstractItemView {
  background-color: #21232c;
  color: #e4e6eb;
  border: 1px solid #323542;
  border-radius: 0px;
  margin: 0px;
  padding: 0px;
  outline: none;
  selection-background-color: #343846;
  selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
  background-color: #21232c;
  color: #e4e6eb;
  padding: 6px 10px;
  min-height: 24px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
  background-color: #343846;
  color: #ffffff;
}

QCheckBox, QRadioButton {
  spacing: 8px;
  padding: 4px 1px;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #4a4e60;
  border-radius: 3px;
  background-color: #21232c;
}

QCheckBox::indicator:checked {
  background-color: #a89ef0;
  border-color: #a89ef0;
  image: url(icons:check.png);
}

QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #4a4e60;
  border-radius: 7px;
  background-color: #21232c;
}

QRadioButton::indicator:checked {
  background-color: #21232c;
  border: 4px solid #a89ef0;
}

QPushButton {
  background-color: #2a2d38;
  color: #e4e6eb;
  border: 1px solid #353947;
  border-radius: 6px;
  padding: 5px 12px;
  min-height: 28px;
}

QPushButton:hover:enabled {
  background-color: #343846;
  border-color: #434859;
}

QPushButton:pressed:enabled {
  background-color: #3d4252;
}

QPushButton:disabled {
  background-color: #1f2129;
  color: #565a6e;
  border-color: #282a34;
}

QPushButton#primaryBtn {
  background-color: #a89ef0;
  border-color: #a89ef0;
  color: #181920;
  font-weight: 700;
}

QPushButton#primaryBtn:hover:enabled {
  background-color: #b8aff5;
  border-color: #b8aff5;
}

QPushButton#primaryBtn:pressed:enabled {
  background-color: #9589e8;
  border-color: #9589e8;
}

QPushButton#dangerBtn {
  background-color: #2a2d38;
  border-color: #6b353c;
  color: #f28b96;
}

QPushButton#dangerBtn:hover:enabled {
  background-color: #3a2328;
  border-color: #8c434d;
}

QTableWidget {
  background-color: #21232c;
  border: 1px solid #2e313d;
  gridline-color: #2a2d38;
  color: #e4e6eb;
}

QHeaderView::section {
  background-color: #262934;
  color: #c4c7d4;
  border: none;
  border-bottom: 1px solid #323542;
  padding: 5px;
  font-weight: 600;
}

QListWidget, QListView, QTreeView {
  background-color: #1c1d24;
  color: #e4e6eb;
  border: 1px solid #2e313d;
  border-radius: 6px;
  outline: none;
}

QListWidget::item, QListView::item, QTreeView::item {
  background-color: #262934;
  color: #e4e6eb;
  border: 1px solid #323542;
  border-radius: 5px;
  padding: 6px 10px;
  margin: 3px 4px;
}

QListWidget::item:hover, QListView::item:hover, QTreeView::item:hover {
  background-color: #343846;
}

QListWidget::item:selected, QListView::item:selected, QTreeView::item:selected {
  background-color: #3d4252;
  border-color: #a89ef0;
  color: #ffffff;
}

QScrollArea {
  background-color: transparent;
  border: none;
}

QScrollArea > QWidget > QWidget {
  background-color: transparent;
}

QProgressBar {
  background-color: #21232c;
  border: 1px solid #323542;
  border-radius: 4px;
  min-height: 14px;
  text-align: center;
  color: #e4e6eb;
}

QProgressBar::chunk {
  background-color: #a89ef0;
  border-radius: 3px;
}

QPlainTextEdit {
  background-color: #1c1d24;
  color: #c4c7d4;
  border: 1px solid #2e313d;
  border-radius: 4px;
  font-family: "Consolas", "D2Coding", "Malgun Gothic", monospace;
  font-size: 11px;
  padding: 6px;
}

QLabel#hintLabel {
  color: #8e92a4;
  font-size: 11px;
}

QLabel#statusInfo {
  color: #a89ef0;
  font-weight: 600;
}

QLabel#statusOk {
  color: #6ee7b7;
  font-weight: 600;
}

QLabel#statusWarn {
  color: #fbbf24;
  font-weight: 600;
}

QLabel#statusMute {
  color: #8e92a4;
}

QSplitter::handle {
  background-color: transparent;
  width: 2px;
  margin: 4px 2px;
}

QWidget#settingsContent {
  background: transparent;
}

QWidget#settingsScroll {
  background: transparent;
  border: none;
}

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 3px 1px 3px 3px;
  border: none;
}

QScrollBar::handle:vertical {
  background: #3a3e4d;
  min-height: 34px;
  border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
  background: #4e5366;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
  border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: transparent;
}

QScrollBar:horizontal {
  background: transparent;
  height: 10px;
  margin: 1px 3px;
  border: none;
}

QScrollBar::handle:horizontal {
  background: #3a3e4d;
  min-width: 34px;
  border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
  background: #4e5366;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0;
  border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: transparent;
}