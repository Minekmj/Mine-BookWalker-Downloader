
* {
  font-family: "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
  font-size: 12px;
}

QMainWindow, QDialog {
  background-color: #f6f7f9;
  color: #1f2328;
}

QLabel, QCheckBox, QRadioButton {
  background-color: transparent;
  color: #1f2328;
}

QLabel:disabled, QCheckBox:disabled, QRadioButton:disabled {
  color: #9ca3af;
}

QTabWidget::pane {
  border: 1px solid #e1e4e8;
  border-radius: 4px;
  background-color: #ffffff;
  padding: 10px;
}

QTabBar::tab {
  background-color: transparent;
  color: #6b7280;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 8px 16px;
  margin-right: 4px;
}

QTabBar::tab:selected {
  color: #111827;
  font-weight: 700;
  border-bottom: 2px solid #2c3540;
}

QTabBar::tab:hover:!selected {
  color: #374151;
}

QGroupBox {
  background-color: #ffffff;
  border: 1px solid #e2e6eb;
  border-radius: 7px;
  margin-top: 12px;
  padding: 14px 12px 10px 12px;
  font-weight: 600;
  color: #4b5563;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 2px 7px;
  background-color: #ffffff;
  border: 1px solid #e2e6eb;
  border-radius: 11px;
  color: #374151;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
  background-color: #ffffff;
  color: #1f2328;
  border: 1px solid #d1d5db;
  border-radius: 5px;
  padding: 4px 8px;
  min-height: 22px;
}

QComboBox {
  min-height: 30px;
  padding: 5px 30px 5px 9px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
  border-color: #4b5563;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
  background-color: #f9fafb;
  color: #9ca3af;
  border-color: #e5e7eb;
}

QSpinBox, QDoubleSpinBox {
  padding-right: 20px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 18px;
  background-color: #f9fafb;
  border-left: 1px solid #d1d5db;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 18px;
  background-color: #f9fafb;
  border-left: 1px solid #d1d5db;
  border-top: 1px solid #d1d5db;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  image: url(icons:arrow_up.png);
  width: 9px;
  height: 9px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  image: url(icons:arrow_down.png);
  width: 9px;
  height: 9px;
}

QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 22px;
  border-left: 1px solid #d1d5db;
  background-color: #f9fafb;
}

QComboBox::down-arrow {
  image: url(icons:arrow_down.png);
  width: 10px;
  height: 10px;
}

QComboBox QAbstractItemView {
  background-color: #ffffff;
  color: #1f2328;
  border: 1px solid #d1d5db;
  selection-background-color: #f3f4f6;
  selection-color: #111827;
}

QCheckBox, QRadioButton {
  spacing: 8px;
  padding: 4px 1px;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #9ca3af;
  border-radius: 3px;
  background-color: #ffffff;
}

QCheckBox::indicator:checked {
  background-color: #2c3540;
  border-color: #2c3540;
  image: url(icons:check.png);
}

QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #9ca3af;
  border-radius: 7px;
  background-color: #ffffff;
}

QRadioButton::indicator:checked {
  background-color: #ffffff;
  border: 4px solid #2c3540;
}

QPushButton {
  background-color: #ffffff;
  color: #1f2328;
  border: 1px solid #d1d5db;
  border-radius: 5px;
  padding: 5px 12px;
  min-height: 28px;
}

QPushButton:hover:enabled {
  background-color: #f3f4f6;
}

QPushButton:pressed:enabled {
  background-color: #e5e7eb;
}

QPushButton:disabled {
  color: #9ca3af;
  border-color: #e5e7eb;
}

QPushButton#primaryBtn {
  background-color: #2c3540;
  border-color: #2c3540;
  color: #ffffff;
  font-weight: 600;
}

QPushButton#primaryBtn:hover:enabled {
  background-color: #3f4a59;
}

QPushButton#dangerBtn {
  background-color: #ffffff;
  border-color: #e5b4b4;
  color: #b91c1c;
}

QPushButton#dangerBtn:hover:enabled {
  background-color: #fef2f2;
}

QTableWidget {
  background-color: #ffffff;
  border: 1px solid #e5e7eb;
  gridline-color: #f1f3f5;
}

QHeaderView::section {
  background-color: #f9fafb;
  color: #374151;
  border: none;
  border-bottom: 1px solid #e5e7eb;
  padding: 5px;
  font-weight: 600;
}

QProgressBar {
  background-color: #f3f4f6;
  border: 1px solid #e5e7eb;
  border-radius: 3px;
  min-height: 14px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: #4b5563;
}

QPlainTextEdit {
  background-color: #fafafa;
  color: #334155;
  border: 1px solid #e5e7eb;
  border-radius: 3px;
  font-family: "Consolas", "D2Coding", "Malgun Gothic", monospace;
  font-size: 11px;
  padding: 6px;
}

QLabel#hintLabel {
  color: #6b7280;
  font-size: 11px;
}

QLabel#statusInfo {
  color: #334155;
  font-weight: 600;
}

QLabel#statusOk {
  color: #166534;
  font-weight: 600;
}

QLabel#statusWarn {
  color: #9a3412;
  font-weight: 600;
}

QLabel#statusMute {
  color: #6b7280;
}

QSplitter::handle {
  background-color: transparent;
  width: 2px;
  margin: 4px 2px;
}

QWidget#settingsContent {
  background: transparent;
}

QWidget#settingsScroll {
  background: transparent;
  border: none;
}

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 3px 1px 3px 3px;
  border: none;
}

QScrollBar::handle:vertical {
  background: #c7cdd5;
  min-height: 34px;
  border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
  background: #9ca6b2;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
  border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: transparent;
}

QScrollBar:horizontal {
  background: transparent;
  height: 10px;
  margin: 1px 3px;
  border: none;
}

QScrollBar::handle:horizontal {
  background: #c7cdd5;
  min-width: 34px;
  border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
  background: #9ca6b2;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0;
  border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: transparent;
}
